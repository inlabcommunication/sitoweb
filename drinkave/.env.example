# --- Firebase (Console Firebase > Impostazioni progetto > Le tue app > App web) ---
# Se queste variabili mancano, l'app parte in MODALITÀ DEMO (dati salvati solo nel browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloud Messaging > Certificati push web > Coppia di chiavi (chiave pubblica VAPID)
VITE_FIREBASE_VAPID_KEY=

# --- Solo lato server (Vercel > Settings > Environment Variables), NON mettere VITE_ davanti ---
# JSON dell'account di servizio (Impostazioni progetto > Account di servizio > Genera nuova chiave privata),
# incollato su una sola riga. Serve per inviare le notifiche push.
FIREBASE_SERVICE_ACCOUNT=
